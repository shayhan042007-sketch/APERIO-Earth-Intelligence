# Database Configuration
# Default to SQLite if DATABASE_URL is not set:
# DATABASE_URL=sqlite:///./aperio.db

# PostgreSQL Configuration:
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/aperio

# Optional individual connection variables if needed by custom scripts:
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGDATABASE=aperio
# PGPASSWORD=
